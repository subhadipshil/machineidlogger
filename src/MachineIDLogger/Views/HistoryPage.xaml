<Page
    x:Class="MachineIDLogger.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MachineIDLogger.Core.Models"
    xmlns:vm="using:MachineIDLogger.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="20,16,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="Machine ID History" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Persistent audit trail of all MachineGuid changes, backups, and restores stored in C:\MachineIDLogger\History\history.db" 
                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondary}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Command="{x:Bind ViewModel.ClearHistoryCommand}" ToolTipService.ToolTip="Clear audit history">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74D;" FontSize="12" />
                        <TextBlock Text="Clear History" FontSize="12" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Status InfoBar -->
        <InfoBar Grid.Row="1" IsOpen="{x:Bind ViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                 Severity="Informational" Title="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" IsClosable="True" />

        <!-- History ListView -->
        <Border Grid.Row="2" Style="{StaticResource TechnicalCardStyle}" Padding="0">
            <ListView ItemsSource="{x:Bind ViewModel.HistoryEntries, Mode=OneWay}" SelectionMode="None">
                <ListView.HeaderTemplate>
                    <DataTemplate>
                        <Grid Padding="12,8" Background="{ThemeResource LayerFillColorDefault}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="1.8*" />
                                <ColumnDefinition Width="1.8*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Date &amp; Time" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondary}" />
                            <TextBlock Grid.Column="1" Text="Action" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondary}" />
                            <TextBlock Grid.Column="2" Text="New / Active ID" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondary}" />
                            <TextBlock Grid.Column="3" Text="Previous ID" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondary}" />
                            <TextBlock Grid.Column="4" Text="Result" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondary}" />
                            <TextBlock Grid.Column="5" Text="Actions" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondary}" HorizontalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.HeaderTemplate>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:MachineGuidHistoryEntry">
                        <Grid Padding="12,8" BorderBrush="{ThemeResource CardStrokeColorDefault}" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="1.8*" />
                                <ColumnDefinition Width="1.8*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{x:Bind TimestampDisplay}" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Action}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{x:Bind NewGuid}" FontFamily="{StaticResource MonospaceFont}" FontSize="11" VerticalAlignment="Center" IsTextSelectionEnabled="True" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3" Text="{x:Bind PreviousGuid}" FontFamily="{StaticResource MonospaceFont}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondary}" VerticalAlignment="Center" IsTextSelectionEnabled="True" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="4" Text="{x:Bind Status}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <Button Tag="{x:Bind}" Click="CopyGuid_Click" Padding="6,4" ToolTipService.ToolTip="Copy GUID">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                                </Button>
                                <Button Tag="{x:Bind}" Click="Restore_Click" Style="{ThemeResource AccentButtonStyle}" Padding="6,4" ToolTipService.ToolTip="Restore this GUID">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE777;" FontSize="11" />
                                        <TextBlock Text="Restore" FontSize="11" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Page>
