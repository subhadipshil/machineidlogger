<Page
    x:Class="MachineIDLogger.Views.NetworkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:MachineIDLogger.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Padding="20,16,24,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="Network Adapters &amp; Interfaces" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Physical NICs, virtual adapters, MAC addresses, link speeds, IPv4/IPv6 configurations" 
                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondary}" />
                </StackPanel>
                <CheckBox Grid.Column="1" Content="Physical Adapters Only" IsChecked="{x:Bind ViewModel.ShowPhysicalOnly, Mode=TwoWay}" VerticalAlignment="Center" />
            </Grid>

            <ListView ItemsSource="{x:Bind ViewModel.Adapters, Mode=OneWay}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource TechnicalCardStyle}" Margin="0,0,0,12">
                            <StackPanel Spacing="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE839;" FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding InterfaceType}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondary}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding OperationalStatus}" FontSize="12" FontWeight="SemiBold" 
                                               Foreground="{Binding OperationalStatus, Converter={StaticResource DiagnosticStatusToBrushConverter}}" />
                                </Grid>

                                <Grid ColumnSpacing="16" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Description" Style="{StaticResource ValueTextStyle}" Foreground="{ThemeResource TextFillColorSecondary}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Description}" Style="{StaticResource ValueTextStyle}" />

                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Link Speed" Style="{StaticResource ValueTextStyle}" Foreground="{ThemeResource TextFillColorSecondary}" />
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding FormattedSpeed}" Style="{StaticResource ValueTextStyle}" FontWeight="SemiBold" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="MAC Address" Style="{StaticResource ValueTextStyle}" Foreground="{ThemeResource TextFillColorSecondary}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MacAddress}" Style="{StaticResource MonospaceValueStyle}" FontWeight="SemiBold" />

                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="DHCP Server" Style="{StaticResource ValueTextStyle}" Foreground="{ThemeResource TextFillColorSecondary}" />
                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding DhcpServer}" Style="{StaticResource ValueTextStyle}" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="IPv4 Addresses" Style="{StaticResource ValueTextStyle}" Foreground="{ThemeResource TextFillColorSecondary}" />
                                    <ItemsControl Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Ipv4Addresses}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Style="{StaticResource MonospaceValueStyle}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="IPv6 Addresses" Style="{StaticResource ValueTextStyle}" Foreground="{ThemeResource TextFillColorSecondary}" />
                                    <ItemsControl Grid.Row="2" Grid.Column="3" ItemsSource="{Binding Ipv6Addresses}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Style="{StaticResource MonospaceValueStyle}" FontSize="11" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
