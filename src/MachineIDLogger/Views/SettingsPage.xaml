<Page
    x:Class="MachineIDLogger.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:MachineIDLogger.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Padding="20,16,24,24">
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="Settings &amp; Preferences" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Appearance, polling intervals, safety confirmation rules, and persistence directories" 
                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondary}" />
                </StackPanel>
                <Button Grid.Column="1" Style="{ThemeResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveCommand}" Click="Save_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74E;" FontSize="12" />
                        <TextBlock Text="Save Settings" FontSize="12" />
                    </StackPanel>
                </Button>
            </Grid>

            <InfoBar IsOpen="{x:Bind ViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                     Severity="Success" Title="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" IsClosable="True" />

            <!-- General Group -->
            <Border Style="{StaticResource TechnicalCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="GENERAL &amp; APPEARANCE" Style="{StaticResource SectionHeaderStyle}" />
                    
                    <Grid RowSpacing="10" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="250" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Application Theme" Style="{StaticResource ValueTextStyle}" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ViewModel.Themes}"
                                  SelectedItem="{x:Bind ViewModel.Settings.Theme, Mode=TwoWay}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Metric Refresh Interval" Style="{StaticResource ValueTextStyle}" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <NumberBox Value="{x:Bind ViewModel.Settings.MetricRefreshIntervalSeconds, Mode=TwoWay}" Minimum="1" Maximum="30" Width="100" />
                            <TextBlock Text="seconds" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondary}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Identity Safety Rules -->
            <Border Style="{StaticResource TechnicalCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="IDENTITY SAFETY &amp; VERIFICATION POLICIES" Style="{StaticResource SectionHeaderStyle}" />

                    <ToggleSwitch Header="Confirm before applying Machine ID modifications" 
                                  IsOn="{x:Bind ViewModel.Settings.ConfirmBeforeModification, Mode=TwoWay}" />

                    <ToggleSwitch Header="Create automatic JSON backup before mutation" 
                                  IsOn="{x:Bind ViewModel.Settings.AutomaticBackupBeforeModification, Mode=TwoWay}" />

                    <ToggleSwitch Header="Verify registry value immediately post-write" 
                                  IsOn="{x:Bind ViewModel.Settings.AutomaticVerificationAfterModification, Mode=TwoWay}" />

                    <ToggleSwitch Header="Mask sensitive hardware serials by default in UI" 
                                  IsOn="{x:Bind ViewModel.Settings.MaskSensitiveIdentifiersInUI, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <!-- Persistent Storage Location -->
            <Border Style="{StaticResource TechnicalCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="PERSISTENT DATA STORAGE" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Text="Location of SQLite audit history, JSON backups, and rolling local text logs:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondary}" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{x:Bind ViewModel.Settings.DataDirectory, Mode=TwoWay}" 
                                 FontFamily="{StaticResource MonospaceFont}" IsReadOnly="True" />
                        <Button Grid.Column="1" Command="{x:Bind ViewModel.OpenDataFolderCommand}" Click="OpenDataFolder_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8DA;" FontSize="12" />
                                <TextBlock Text="Open Folder" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
