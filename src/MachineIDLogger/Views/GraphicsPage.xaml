<Page
    x:Class="MachineIDLogger.Views.GraphicsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:MachineIDLogger.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Padding="20,16,24,24">
            <StackPanel Spacing="2">
                <TextBlock Text="Graphics (GPU)" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Display adapters, dedicated video memory, driver versions, and hardware identifiers" 
                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondary}" />
            </StackPanel>

            <ListView ItemsSource="{x:Bind ViewModel.Gpus, Mode=OneWay}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource TechnicalCardStyle}" Margin="0,0,0,12">
                            <StackPanel Spacing="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE790;" FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondary}" />
                                </Grid>

                                <Grid ColumnSpacing="16" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Manufacturer" Style="{StaticResource ValueTextStyle}" Foreground="{ThemeResource TextFillColorSecondary}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Manufacturer}" Style="{StaticResource ValueTextStyle}" />

                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Dedicated VRAM" Style="{StaticResource ValueTextStyle}" Foreground="{ThemeResource TextFillColorSecondary}" />
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding FormattedDedicatedMemory}" Style="{StaticResource ValueTextStyle}" FontWeight="SemiBold" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Driver Version" Style="{StaticResource ValueTextStyle}" Foreground="{ThemeResource TextFillColorSecondary}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DriverVersion}" Style="{StaticResource MonospaceValueStyle}" />

                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Driver Date" Style="{StaticResource ValueTextStyle}" Foreground="{ThemeResource TextFillColorSecondary}" />
                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding DriverDate}" Style="{StaticResource ValueTextStyle}" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="PNP Device ID" Style="{StaticResource ValueTextStyle}" Foreground="{ThemeResource TextFillColorSecondary}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding PnpDeviceId}" Style="{StaticResource MonospaceValueStyle}" FontSize="11" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
