<Page
    x:Class="MachineIDLogger.Views.CoffeePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:MachineIDLogger.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Padding="24,20,24,24" MaxWidth="720" HorizontalAlignment="Left">
            
            <!-- Page Header -->
            <StackPanel Spacing="3">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE7EB;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                    <TextBlock Text="Buy Me a Coffee ☕" FontSize="22" FontWeight="Bold" />
                </StackPanel>
                <TextBlock Text="Support the independent developer behind MachineIDLogger" 
                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondary}" />
            </StackPanel>

            <!-- Main Support Card -->
            <Border Style="{StaticResource TechnicalCardStyle}" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}">
                <StackPanel Spacing="16">
                    
                    <TextBlock Text="MachineIDLogger is 100% free and open-source software built for Windows developers, technicians, and system administrators. If this utility has been useful in inspecting your hardware, diagnosing issues, or managing identifiers, a voluntary contribution helps keep active development, updates, and maintenance going!" 
                               FontSize="13" LineHeight="20" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorPrimary}" />

                    <!-- QR Code Card -->
                    <Border Background="White" CornerRadius="12" Padding="6" HorizontalAlignment="Center" BorderThickness="1" BorderBrush="#CBD5E1" Shadow="{ThemeResource SharedShadow}">
                        <Image Source="ms-appx:///Assets/BeautifiedQr.png" Width="300" Height="350" Stretch="Uniform" />
                    </Border>

                    <!-- Payment Details & Actions -->
                    <Grid Background="{ThemeResource LayerFillColorDefault}" CornerRadius="6" Padding="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="UPI PAYMENT ID" Style="{StaticResource SectionHeaderStyle}" FontSize="10" />
                            <TextBlock Text="{x:Bind ViewModel.UpiId, Mode=OneWay}"
                                       FontFamily="{StaticResource MonospaceFont}" FontSize="15" FontWeight="Bold" 
                                       IsTextSelectionEnabled="True" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Style="{ThemeResource AccentButtonStyle}" Command="{x:Bind ViewModel.CopyUpiIdCommand}" Click="CopyUpiId_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                                    <TextBlock Text="Copy UPI ID" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <Button Command="{x:Bind ViewModel.OpenUpiPaymentCommand}" Click="OpenUpiPayment_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8A7;" FontSize="12" />
                                    <TextBlock Text="Open UPI Link" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <Button Command="{x:Bind ViewModel.OpenBuyMeCoffeeWebCommand}" Click="OpenBuyMeCoffeeWeb_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xEC05;" FontSize="12" />
                                    <TextBlock Text="Buy Me a Coffee (Web)" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Feedback message -->
                    <InfoBar IsOpen="{x:Bind ViewModel.CopyFeedback, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                             Severity="Success" Title="{x:Bind ViewModel.CopyFeedback, Mode=OneWay}" IsClosable="True" />

                    <!-- Developer Info -->
                    <Grid RowSpacing="6" ColumnSpacing="16" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Developer" Style="{StaticResource ValueTextStyle}" Foreground="{ThemeResource TextFillColorSecondary}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.Developer, Mode=OneWay}" Style="{StaticResource ValueTextStyle}" FontWeight="SemiBold" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Project Repository" Style="{StaticResource ValueTextStyle}" Foreground="{ThemeResource TextFillColorSecondary}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.GitHubRepoUrl, Mode=OneWay}" Style="{StaticResource MonospaceValueStyle}" IsTextSelectionEnabled="True" />
                    </Grid>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
