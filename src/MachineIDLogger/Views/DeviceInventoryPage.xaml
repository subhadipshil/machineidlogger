<Page
    x:Class="MachineIDLogger.Views.DeviceInventoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MachineIDLogger.Core.Models"
    xmlns:vm="using:MachineIDLogger.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="20,16,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="Device Inventory" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="Complete catalog of hardware devices, bus controllers, and PNP entities detected by Windows" 
                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondary}" />
        </StackPanel>

        <!-- Search & Filter Toolbar -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" PlaceholderText="Search device name, manufacturer, or hardware ID..." 
                     Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                      ItemsSource="{x:Bind ViewModel.Categories}" 
                      SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}" />

            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.FilteredDevices.Count, Mode=OneWay, Converter={StaticResource DeviceCountConverter}}"
                       VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondary}" />
        </Grid>

        <!-- Technical Devices Table -->
        <Border Grid.Row="2" Style="{StaticResource TechnicalCardStyle}" Padding="0">
            <ListView ItemsSource="{x:Bind ViewModel.FilteredDevices, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedDevice, Mode=TwoWay}"
                      SelectionMode="Single">
                <ListView.HeaderTemplate>
                    <DataTemplate>
                        <Grid Padding="12,8" Background="{ThemeResource LayerFillColorDefault}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Device Name" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondary}" />
                            <TextBlock Grid.Column="1" Text="Category" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondary}" />
                            <TextBlock Grid.Column="2" Text="Manufacturer" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondary}" />
                            <TextBlock Grid.Column="3" Text="Status" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondary}" />
                            <TextBlock Grid.Column="4" Text="Hardware Identifier" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondary}" />
                            <TextBlock Grid.Column="5" Text="Action" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondary}" HorizontalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.HeaderTemplate>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:DeviceItemInfo">
                        <Grid Padding="12,6" BorderBrush="{ThemeResource CardStrokeColorDefault}" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{x:Bind Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Category}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondary}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Manufacturer}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{x:Bind Status}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="{x:Bind PrimaryHardwareId}" FontFamily="{StaticResource MonospaceFont}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" IsTextSelectionEnabled="True" />
                            <Button Grid.Column="5" Tag="{x:Bind}" Click="CopyButton_Click" HorizontalAlignment="Center" Padding="6,4" ToolTipService.ToolTip="Copy Hardware ID">
                                <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Selected Device Details Drawer -->
        <Border Grid.Row="3" Style="{StaticResource TechnicalCardStyle}" Visibility="{x:Bind ViewModel.SelectedDevice, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
            <StackPanel Spacing="6">
                <Grid>
                    <TextBlock Text="SELECTED DEVICE DETAILS" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.SelectedDevice.DeviceId, Mode=OneWay}" FontFamily="{StaticResource MonospaceFont}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiary}" HorizontalAlignment="Right" IsTextSelectionEnabled="True" />
                </Grid>
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="Device Class: " FontSize="11" Foreground="{ThemeResource TextFillColorSecondary}">
                            <Run Text="{x:Bind ViewModel.SelectedDevice.PnpClass, Mode=OneWay}" Foreground="{ThemeResource TextFillColorPrimary}" />
                        </TextBlock>
                        <TextBlock Text="Service Driver: " FontSize="11" Foreground="{ThemeResource TextFillColorSecondary}">
                            <Run Text="{x:Bind ViewModel.SelectedDevice.Service, Mode=OneWay}" Foreground="{ThemeResource TextFillColorPrimary}" />
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="Primary Hardware ID:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondary}" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedDevice.PrimaryHardwareId, Mode=OneWay}" FontFamily="{StaticResource MonospaceFont}" FontSize="11" IsTextSelectionEnabled="True" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Page>
