<Page
    x:Class="MachineIDLogger.Views.MemoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:MachineIDLogger.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Padding="20,16,24,24">
            <StackPanel Spacing="2">
                <TextBlock Text="Memory (RAM)" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Physical memory capacity, utilization metrics, and physical DIMM/SODIMM hardware module inventory" 
                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondary}" />
            </StackPanel>

            <!-- Memory Summary Cards -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource TechnicalCardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="TOTAL INSTALLED" Style="{StaticResource SectionHeaderStyle}" FontSize="10" />
                        <TextBlock Text="{x:Bind ViewModel.Memory.FormattedTotal, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="High precision physical RAM" FontSize="11" Foreground="{ThemeResource TextFillColorTertiary}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource TechnicalCardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="USED MEMORY" Style="{StaticResource SectionHeaderStyle}" FontSize="10" />
                        <TextBlock Text="{x:Bind ViewModel.Memory.FormattedUsed, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind ViewModel.Memory.LoadPercentage, Mode=OneWay, Converter={StaticResource PercentageFormatConverter}}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiary}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource TechnicalCardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="AVAILABLE MEMORY" Style="{StaticResource SectionHeaderStyle}" FontSize="10" />
                        <TextBlock Text="{x:Bind ViewModel.Memory.FormattedAvailable, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Free for allocation" FontSize="11" Foreground="{ThemeResource TextFillColorTertiary}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource TechnicalCardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="MODULES COUNT" Style="{StaticResource SectionHeaderStyle}" FontSize="10" />
                        <TextBlock Text="{x:Bind ViewModel.Memory.ModuleCount, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Physical DIMMs detected" FontSize="11" Foreground="{ThemeResource TextFillColorTertiary}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Detailed Module Table -->
            <Border Style="{StaticResource TechnicalCardStyle}">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="PHYSICAL MEMORY MODULES (DIMM/SODIMM)" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock Grid.Column="1" Text="Source: Win32_PhysicalMemory" FontSize="11" Foreground="{ThemeResource TextFillColorTertiary}" />
                    </Grid>

                    <ListView ItemsSource="{x:Bind ViewModel.Memory.Modules, Mode=OneWay}" SelectionMode="None">
                        <ListView.HeaderTemplate>
                            <DataTemplate>
                                <Grid Padding="8,4" Background="{ThemeResource LayerFillColorDefault}" CornerRadius="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Slot" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondary}" />
                                    <TextBlock Grid.Column="1" Text="Capacity" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondary}" />
                                    <TextBlock Grid.Column="2" Text="Speed" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondary}" />
                                    <TextBlock Grid.Column="3" Text="Type" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondary}" />
                                    <TextBlock Grid.Column="4" Text="Manufacturer" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondary}" />
                                    <TextBlock Grid.Column="5" Text="Part Number" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondary}" />
                                    <TextBlock Grid.Column="6" Text="Serial Number" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondary}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.HeaderTemplate>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8,6" BorderBrush="{ThemeResource CardStrokeColorDefault}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding DeviceLocator}" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding FormattedCapacity}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding SpeedMhz}" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding MemoryType}" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{Binding Manufacturer}" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="5" Text="{Binding PartNumber}" FontFamily="{StaticResource MonospaceFont}" FontSize="11" VerticalAlignment="Center" IsTextSelectionEnabled="True" />
                                    <TextBlock Grid.Column="6" Text="{Binding SerialNumber}" FontFamily="{StaticResource MonospaceFont}" FontSize="11" VerticalAlignment="Center" IsTextSelectionEnabled="True" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
