<Page
    x:Class="MachineIDLogger.Views.ProcessorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:MachineIDLogger.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Padding="20,16,24,24">
            <StackPanel Spacing="2">
                <TextBlock Text="Processor (CPU)" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Hardware specifications, topology, clock frequencies, and live processor utilization" 
                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondary}" />
            </StackPanel>

            <!-- Top Highlights -->
            <Border Style="{StaticResource TechnicalCardStyle}">
                <StackPanel Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind ViewModel.Cpu.Name, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" IsTextSelectionEnabled="True" />
                        <TextBlock Grid.Column="1" Text="Source: Win32_Processor" FontSize="11" Foreground="{ThemeResource TextFillColorTertiary}" />
                    </Grid>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="ARCHITECTURE" Style="{StaticResource SectionHeaderStyle}" FontSize="10" />
                            <TextBlock Text="{x:Bind ViewModel.Cpu.Architecture, Mode=OneWay}" Style="{StaticResource ValueTextStyle}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="PHYSICAL CORES" Style="{StaticResource SectionHeaderStyle}" FontSize="10" />
                            <TextBlock Text="{x:Bind ViewModel.Cpu.PhysicalCores, Mode=OneWay}" Style="{StaticResource ValueTextStyle}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="LOGICAL PROCESSORS" Style="{StaticResource SectionHeaderStyle}" FontSize="10" />
                            <TextBlock Text="{x:Bind ViewModel.Cpu.LogicalProcessors, Mode=OneWay}" Style="{StaticResource ValueTextStyle}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="MAX FREQUENCY" Style="{StaticResource SectionHeaderStyle}" FontSize="10" />
                            <TextBlock Text="{x:Bind ViewModel.Cpu.MaxClockSpeedMhz, Mode=OneWay}" Style="{StaticResource ValueTextStyle}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="4" Margin="0,8,0,0">
                        <Grid>
                            <TextBlock Text="Live CPU Utilization" FontSize="11" Foreground="{ThemeResource TextFillColorSecondary}" />
                            <TextBlock Text="{x:Bind ViewModel.LiveUsage, Mode=OneWay, Converter={StaticResource PercentageFormatConverter}}" HorizontalAlignment="Right" FontSize="11" />
                        </Grid>
                        <ProgressBar Value="{x:Bind ViewModel.LiveUsage, Mode=OneWay}" Maximum="100" Height="6" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Technical Specifications Grid -->
            <Border Style="{StaticResource TechnicalCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="PROCESSOR HARDWARE DETAILS" Style="{StaticResource SectionHeaderStyle}" />
                    
                    <Grid RowSpacing="8" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Manufacturer" Style="{StaticResource ValueTextStyle}" Foreground="{ThemeResource TextFillColorSecondary}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.Cpu.Manufacturer, Mode=OneWay}" Style="{StaticResource ValueTextStyle}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Socket / Package" Style="{StaticResource ValueTextStyle}" Foreground="{ThemeResource TextFillColorSecondary}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.Cpu.SocketDesignation, Mode=OneWay}" Style="{StaticResource ValueTextStyle}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="L2 Cache" Style="{StaticResource ValueTextStyle}" Foreground="{ThemeResource TextFillColorSecondary}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.Cpu.L2CacheSize, Mode=OneWay}" Style="{StaticResource ValueTextStyle}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="L3 Cache" Style="{StaticResource ValueTextStyle}" Foreground="{ThemeResource TextFillColorSecondary}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.Cpu.L3CacheSize, Mode=OneWay}" Style="{StaticResource ValueTextStyle}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Virtualization (VT-x / AMD-V)" Style="{StaticResource ValueTextStyle}" Foreground="{ThemeResource TextFillColorSecondary}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.Cpu.VirtualizationEnabled, Mode=OneWay}" Style="{StaticResource ValueTextStyle}" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Processor ID" Style="{StaticResource ValueTextStyle}" Foreground="{ThemeResource TextFillColorSecondary}" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{x:Bind ViewModel.Cpu.ProcessorId, Mode=OneWay}" Style="{StaticResource MonospaceValueStyle}" />

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Stepping" Style="{StaticResource ValueTextStyle}" Foreground="{ThemeResource TextFillColorSecondary}" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{x:Bind ViewModel.Cpu.Stepping, Mode=OneWay}" Style="{StaticResource ValueTextStyle}" />
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
