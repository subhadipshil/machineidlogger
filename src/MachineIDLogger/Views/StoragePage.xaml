<Page
    x:Class="MachineIDLogger.Views.StoragePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:MachineIDLogger.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Padding="20,16,24,24">
            <StackPanel Spacing="2">
                <TextBlock Text="Storage Drives &amp; Volumes" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Physical hard drives, NVMe/SATA SSDs, partitions, and logical filesystem volumes" 
                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondary}" />
            </StackPanel>

            <!-- Physical Drives Section -->
            <Border Style="{StaticResource TechnicalCardStyle}">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="PHYSICAL DISK DRIVES" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock Grid.Column="1" Text="Source: Win32_DiskDrive" FontSize="11" Foreground="{ThemeResource TextFillColorTertiary}" />
                    </Grid>

                    <ListView ItemsSource="{x:Bind ViewModel.Drives, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{ThemeResource LayerFillColorDefault}" CornerRadius="4" Padding="12" Margin="0,0,0,8">
                                    <Grid RowSpacing="6" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Model" Style="{StaticResource ValueTextStyle}" Foreground="{ThemeResource TextFillColorSecondary}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Model}" Style="{StaticResource ValueTextStyle}" FontWeight="SemiBold" />

                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Capacity" Style="{StaticResource ValueTextStyle}" Foreground="{ThemeResource TextFillColorSecondary}" />
                                        <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding FormattedSize}" Style="{StaticResource ValueTextStyle}" FontWeight="SemiBold" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Serial Number" Style="{StaticResource ValueTextStyle}" Foreground="{ThemeResource TextFillColorSecondary}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SerialNumber}" Style="{StaticResource MonospaceValueStyle}" />

                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Interface / Type" Style="{StaticResource ValueTextStyle}" Foreground="{ThemeResource TextFillColorSecondary}" />
                                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding InterfaceType}" Style="{StaticResource ValueTextStyle}" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Firmware" Style="{StaticResource ValueTextStyle}" Foreground="{ThemeResource TextFillColorSecondary}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FirmwareRevision}" Style="{StaticResource ValueTextStyle}" />

                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Device ID" Style="{StaticResource ValueTextStyle}" Foreground="{ThemeResource TextFillColorSecondary}" />
                                        <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding DeviceId}" Style="{StaticResource MonospaceValueStyle}" FontSize="11" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- Logical Volumes Section -->
            <Border Style="{StaticResource TechnicalCardStyle}">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="LOGICAL FILESYSTEM VOLUMES" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock Grid.Column="1" Text="Source: System.IO.DriveInfo / Win32_LogicalDisk" FontSize="11" Foreground="{ThemeResource TextFillColorTertiary}" />
                    </Grid>

                    <ListView ItemsSource="{x:Bind ViewModel.Volumes, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{ThemeResource LayerFillColorDefault}" CornerRadius="4" Padding="12" Margin="0,0,0,8">
                                    <Grid ColumnSpacing="16" RowSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="140" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding DriveLetter}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding VolumeLabel}" FontSize="12" VerticalAlignment="Center" />

                                        <StackPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                            <ProgressBar Value="{Binding PercentUsed}" Maximum="100" Height="6" />
                                            <TextBlock Text="{Binding FormattedFree}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondary}" />
                                        </StackPanel>

                                        <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding FormattedTotal}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Format" FontSize="11" Foreground="{ThemeResource TextFillColorSecondary}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FileSystem}" FontSize="11" />

                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Volume Serial" FontSize="11" Foreground="{ThemeResource TextFillColorSecondary}" />
                                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding VolumeSerialNumber}" FontFamily="{StaticResource MonospaceFont}" FontSize="11" HorizontalAlignment="Right" IsTextSelectionEnabled="True" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
