<Page
    x:Class="MachineIDLogger.Views.CursorIdentityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:MachineIDLogger.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Padding="20,16,24,24">
            
            <StackPanel Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Cursor Local Identity" FontSize="20" FontWeight="SemiBold" />
                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text="FEATURED INTEGRATION" FontSize="10" FontWeight="Bold" Foreground="White" />
                    </Border>
                </StackPanel>
                <TextBlock Text="Version-aware local telemetry identity manager for the Cursor AI code editor" 
                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondary}" />
            </StackPanel>

            <InfoBar IsOpen="{x:Bind ViewModel.HasBanner, Mode=OneWay}"
                     Severity="{x:Bind ViewModel.OperationSucceeded, Mode=OneWay, Converter={StaticResource DiagnosticStatusToBrushConverter}}"
                     Title="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" IsClosable="True" />

            <!-- Status Card -->
            <Border Style="{StaticResource TechnicalCardStyle}">
                <StackPanel Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="INSTALLATION &amp; SCHEMA STATUS" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CursorInfo.VersionStatus, Mode=OneWay}" 
                                   FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                    </Grid>

                    <TextBlock Text="{x:Bind ViewModel.CursorInfo.StorageJsonPath, Mode=OneWay}" 
                               FontFamily="{StaticResource MonospaceFont}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiary}" IsTextSelectionEnabled="True" />

                    <InfoBar IsOpen="True" Severity="Informational" IsClosable="False"
                             Title="Independent Scope: Cursor local identity management is completely separate from the Windows MachineGuid. Changing Cursor identity generates new local telemetry hashes and devDevice IDs without altering OS or hardware identifiers." />
                </StackPanel>
            </Border>

            <!-- Identifiers Card -->
            <Border Style="{StaticResource TechnicalCardStyle}">
                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock Text="DETECTED CURSOR TELEMETRY IDENTIFIERS" Style="{StaticResource SectionHeaderStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Style="{ThemeResource AccentButtonStyle}" 
                                    IsEnabled="{x:Bind ViewModel.CursorInfo.IsSupported, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.GenerateNewIdentityCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE777;" FontSize="12" />
                                    <TextBlock Text="Generate New Identity" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid RowSpacing="10" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- machineId -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="telemetry.machineId" Style="{StaticResource ValueTextStyle}" Foreground="{ThemeResource TextFillColorSecondary}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.CursorInfo.MachineId, Mode=OneWay}" Style="{StaticResource MonospaceValueStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Row="0" Grid.Column="2" Click="CopyMachineId_Click" Padding="6,4">
                            <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                        </Button>

                        <!-- macMachineId -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="telemetry.macMachineId" Style="{StaticResource ValueTextStyle}" Foreground="{ThemeResource TextFillColorSecondary}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.CursorInfo.MacMachineId, Mode=OneWay}" Style="{StaticResource MonospaceValueStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Row="1" Grid.Column="2" Click="CopyMacMachineId_Click" Padding="6,4">
                            <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                        </Button>

                        <!-- devDeviceId -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="telemetry.devDeviceId" Style="{StaticResource ValueTextStyle}" Foreground="{ThemeResource TextFillColorSecondary}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.CursorInfo.DevDeviceId, Mode=OneWay}" Style="{StaticResource MonospaceValueStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Row="2" Grid.Column="2" Click="CopyDevDeviceId_Click" Padding="6,4">
                            <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                        </Button>

                        <!-- sqmId -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="telemetry.sqmId" Style="{StaticResource ValueTextStyle}" Foreground="{ThemeResource TextFillColorSecondary}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.CursorInfo.SqmId, Mode=OneWay}" Style="{StaticResource MonospaceValueStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Row="3" Grid.Column="2" Click="CopySqmId_Click" Padding="6,4">
                            <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Backups Section -->
            <Border Style="{StaticResource TechnicalCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="HISTORICAL CURSOR BACKUPS (C:\MachineIDLogger\Backups\cursor)" Style="{StaticResource SectionHeaderStyle}" />
                    <ListView ItemsSource="{x:Bind ViewModel.CursorInfo.AvailableBackups, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8,4" BorderBrush="{ThemeResource CardStrokeColorDefault}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding}" FontFamily="{StaticResource MonospaceFont}" FontSize="11" VerticalAlignment="Center" IsTextSelectionEnabled="True" />
                                    <Button Grid.Column="1" Tag="{Binding}" Click="RestoreBackup_Click" Style="{ThemeResource AccentButtonStyle}" Padding="6,4" ToolTipService.ToolTip="Restore this backup">
                                        <TextBlock Text="Restore" FontSize="11" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
