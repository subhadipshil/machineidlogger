<Page
    x:Class="MachineIDLogger.Views.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MachineIDLogger.Core.Models"
    xmlns:vm="using:MachineIDLogger.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Padding="20,16,24,24">
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="System Diagnostics &amp; Health" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Verify Windows API availability, registry access, WMI health, and persistent storage integrity" 
                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondary}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Click="ExportReport_Click" ToolTipService.ToolTip="Export diagnostic report as standalone HTML file"
                            IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xEDE1;" FontSize="12" />
                            <TextBlock Text="Export Report" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Style="{ThemeResource AccentButtonStyle}" Click="RunDiagnostics_Click" 
                            IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}" 
                            ToolTipService.ToolTip="Execute all system diagnostic tests">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing IsActive="{x:Bind ViewModel.IsRunning, Mode=OneWay}" Width="14" Height="14" 
                                          Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" />
                            <FontIcon Glyph="&#xE768;" FontSize="12" 
                                      Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InvertBoolToVisConverter}}" />
                            <TextBlock Text="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource DiagnosticButtonTextConverter}}" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Active Test Progress Bar -->
            <ProgressBar IsIndeterminate="True" 
                         Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" 
                         HorizontalAlignment="Stretch" Margin="0,-8,0,0" />

            <!-- Results Summary Banner -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource TechnicalCardStyle}" BorderBrush="#22C55E">
                    <StackPanel Spacing="4">
                        <TextBlock Text="PASSED CHECKS" Style="{StaticResource SectionHeaderStyle}" FontSize="10" Foreground="#22C55E" />
                        <TextBlock Text="{x:Bind ViewModel.PassCount, Mode=OneWay, FallbackValue='0', TargetNullValue='0'}" FontSize="20" FontWeight="Bold" Foreground="#22C55E" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource TechnicalCardStyle}" BorderBrush="#EAB308">
                    <StackPanel Spacing="4">
                        <TextBlock Text="WARNINGS" Style="{StaticResource SectionHeaderStyle}" FontSize="10" Foreground="#EAB308" />
                        <TextBlock Text="{x:Bind ViewModel.WarningCount, Mode=OneWay, FallbackValue='0', TargetNullValue='0'}" FontSize="20" FontWeight="Bold" Foreground="#EAB308" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource TechnicalCardStyle}" BorderBrush="#EF4444">
                    <StackPanel Spacing="4">
                        <TextBlock Text="ERRORS" Style="{StaticResource SectionHeaderStyle}" FontSize="10" Foreground="#EF4444" />
                        <TextBlock Text="{x:Bind ViewModel.ErrorCount, Mode=OneWay, FallbackValue='0', TargetNullValue='0'}" FontSize="20" FontWeight="Bold" Foreground="#EF4444" />
                    </StackPanel>
                </Border>
            </Grid>

            <InfoBar IsOpen="{x:Bind ViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                     Severity="Informational" Title="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" IsClosable="True" />

            <!-- Diagnostic Results Collection (ItemsControl avoids ScrollViewer height collapse) -->
            <Border Style="{StaticResource TechnicalCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="DIAGNOSTIC TEST RESULTS" Style="{StaticResource SectionHeaderStyle}" />

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:DiagnosticResult">
                                <Border Background="{ThemeResource LayerFillColorDefault}" CornerRadius="6" Padding="14,10" Margin="0,0,0,8"
                                        BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefault}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{x:Bind CheckName}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="{x:Bind Category}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondary}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{x:Bind Details}" FontSize="12" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind Recommendation}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiary}" TextWrapping="Wrap" />
                                        </StackPanel>

                                        <Border Grid.Column="2" Background="{x:Bind StatusBadge, Converter={StaticResource DiagnosticStatusToBrushConverter}}" 
                                                CornerRadius="4" Padding="10,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind StatusBadge}" FontWeight="Bold" FontSize="11" Foreground="White" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
