<Page
    x:Class="MachineIDLogger.Views.MotherboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:MachineIDLogger.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Padding="20,16,24,24">
            <StackPanel Spacing="2">
                <TextBlock Text="Motherboard &amp; BIOS/UEFI" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="System mainboard specifications, firmware revision, SMBIOS tables, and serial numbers" 
                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondary}" />
            </StackPanel>

            <!-- Motherboard Section -->
            <Border Style="{StaticResource TechnicalCardStyle}">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8EA;" FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="MOTHERBOARD (BASEBOARD)" Style="{StaticResource SectionHeaderStyle}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="Source: Win32_BaseBoard" FontSize="11" Foreground="{ThemeResource TextFillColorTertiary}" />
                    </Grid>

                    <Grid RowSpacing="8" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Manufacturer" Style="{StaticResource ValueTextStyle}" Foreground="{ThemeResource TextFillColorSecondary}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.Motherboard.Manufacturer, Mode=OneWay}" Style="{StaticResource ValueTextStyle}" FontWeight="SemiBold" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Product / Model" Style="{StaticResource ValueTextStyle}" Foreground="{ThemeResource TextFillColorSecondary}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.Motherboard.Product, Mode=OneWay}" Style="{StaticResource ValueTextStyle}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Board Version" Style="{StaticResource ValueTextStyle}" Foreground="{ThemeResource TextFillColorSecondary}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.Motherboard.Version, Mode=OneWay}" Style="{StaticResource ValueTextStyle}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Board Serial Number" Style="{StaticResource ValueTextStyle}" Foreground="{ThemeResource TextFillColorSecondary}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.Motherboard.SerialNumber, Mode=OneWay}" Style="{StaticResource MonospaceValueStyle}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- BIOS / UEFI Section -->
            <Border Style="{StaticResource TechnicalCardStyle}">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE90F;" FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="BIOS / UEFI FIRMWARE" Style="{StaticResource SectionHeaderStyle}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="Source: Win32_BIOS" FontSize="11" Foreground="{ThemeResource TextFillColorTertiary}" />
                    </Grid>

                    <Grid RowSpacing="8" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="BIOS Vendor" Style="{StaticResource ValueTextStyle}" Foreground="{ThemeResource TextFillColorSecondary}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.Bios.Manufacturer, Mode=OneWay}" Style="{StaticResource ValueTextStyle}" FontWeight="SemiBold" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="BIOS Version" Style="{StaticResource ValueTextStyle}" Foreground="{ThemeResource TextFillColorSecondary}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.Bios.Version, Mode=OneWay}" Style="{StaticResource MonospaceValueStyle}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Release Date" Style="{StaticResource ValueTextStyle}" Foreground="{ThemeResource TextFillColorSecondary}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.Bios.ReleaseDate, Mode=OneWay}" Style="{StaticResource ValueTextStyle}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="SMBIOS Version" Style="{StaticResource ValueTextStyle}" Foreground="{ThemeResource TextFillColorSecondary}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.Bios.SmbiosVersion, Mode=OneWay}" Style="{StaticResource ValueTextStyle}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Firmware Serial" Style="{StaticResource ValueTextStyle}" Foreground="{ThemeResource TextFillColorSecondary}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.Bios.SerialNumber, Mode=OneWay}" Style="{StaticResource MonospaceValueStyle}" />
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
